></shadow></value><next><block type=\"hudChangeScoreBy\"><value name=\"value\"><shadow type=\"math_number\"><field name=\"NUM\">10</field></shadow></value><next><block type=\"spritedestroy2\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" _expanded=\"2\" _input_init=\"true\"></mutation><field name=\"effect\">effects.blizzard</field><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"k:QFz*BGRbt=(4)+yGK:\">pez vampiro</field></block></value><value name=\"duration\"><shadow type=\"timePicker\"><field name=\"ms\">500</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type=\"spritesoverlap\" x=\"605\" y=\"1365\"><value name=\"HANDLER_DRAG_PARAM_sprite\"><block type=\"argument_reporter_custom\" deletable=\"false\"><mutation typename=\"Sprite\"></mutation><field name=\"VALUE\">sprite</field></block></value><value name=\"kind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">río</field></shadow></value><value name=\"HANDLER_DRAG_PARAM_otherSprite\"><block type=\"argument_reporter_custom\" deletable=\"false\"><mutation typename=\"Sprite\"></mutation><field name=\"VALUE\">otherSprite</field></block></value><value name=\"otherKind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">Player</field></shadow></value><statement name=\"HANDLER\"><block type=\"game_show_long_text\"><field name=\"layout\">DialogLayout.Bottom</field><value name=\"str\"><shadow type=\"text\"><field name=\"TEXT\">El guacamayo de Spix (Cyanopsitta spixii), también conocido como guacamayo azul pequeño, es un ave psitaciforme endémica de Brasil y se hizo mundialmente famoso por inspirar la película animada Río</field></shadow></value><next><block type=\"game_show_long_text\"><field name=\"layout\">DialogLayout.Bottom</field><value name=\"str\"><shadow type=\"text\"><field name=\"TEXT\">Tamaño y peso: Mide entre 55 y 60 cm de longitud. Los machos pesan alrededor de 320 g y las hembras cerca de 290 g.</field></shadow></value