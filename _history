lue name=\"duration\"><shadow type=\"timePicker\"><field name=\"ms\">500</field></shadow></value></block></next></block></next></block></statement></block><block type=\"spritesoverlap\" x=\"630\" y=\"771\"><value name=\"HANDLER_DRAG_PARAM_sprite\"><block type=\"argument_reporter_custom\" deletable=\"false\"><mutation typename=\"Sprite\"></mutation><field name=\"VALUE\">sprite</field></block></value><value name=\"kind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">tucan</field></shadow></value><value name=\"HANDLER_DRAG_PARAM_otherSprite\"><block type=\"argument_reporter_custom\" deletable=\"false\"><mutation typename=\"Sprite\"></mutation><field name=\"VALUE\">otherSprite</field></block></value><value name=\"otherKind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">Player</field></shadow></value><statement name=\"HANDLER\"><block type=\"game_show_long_text\"><field name=\"layout\">DialogLayout.Bottom</field><value name=\"str\"><shadow type=\"text\"><field name=\"TEXT\">El tucán del Amazonas pertenece a la familia Ramphastidae (que incluye más de 35 a 40 especies en la región neotropical, como el tucán toco y el tucán de garganta blanca). Es uno de los símbolos más representativos de la selva tropical</field></shadow></value><next><block type=\"hudChangeScoreBy\"><value name=\"value\"><shadow type=\"math_number\"><field name=\"NUM\">10</field></shadow></value><next><block type=\"spritedestroy2\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" _expanded=\"2\" _input_init=\"true\"></mutation><field name=\"effect\">effects.blizzard</field><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"3Uv$A2Xt1LZUc{F*YKZm\">Tucán</field></block></value><value name=\"duration\"><shadow type=\"timePicker\"><field name=\"ms\">500</field></shadow></value></block></next></block></next></block></statement></block><block type=\"spritesoverlap\" x=\"1465\" y=\"809\"><value name=\"HANDLER_DRAG_PARAM_sprite\"><block type=\"argument_reporter_custom\" dele