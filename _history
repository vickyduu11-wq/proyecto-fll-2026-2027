ield name=\"effect\">effects.blizzard</field><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"036|Ed@4wEg?G!w?Z!Pz\">Delfin rosado</field></block></value><value name=\"duration\"><shadow type=\"timePicker\"><field name=\"ms\">500</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type=\"spritesoverlap\" x=\"587\" y=\"1063\"><value name=\"HANDLER_DRAG_PARAM_sprite\"><block type=\"argument_reporter_custom\" deletable=\"false\"><mutation typename=\"Sprite\"></mutation><field name=\"VALUE\">sprite</field></block></value><value name=\"kind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">serpiente</field></shadow></value><value name=\"HANDLER_DRAG_PARAM_otherSprite\"><block type=\"argument_reporter_custom\" deletable=\"false\"><mutation typename=\"Sprite\"></mutation><field name=\"VALUE\">otherSprite</field></block></value><value name=\"otherKind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">Player</field></shadow></value><statement name=\"HANDLER\"><block type=\"game_show_long_text\"><field name=\"layout\">DialogLayout.Bottom</field><value name=\"str\"><shadow type=\"text\"><field name=\"TEXT\">La anaconda verde (Eunectes murinus y la recientemente distinguida del norte Eunectes akayima) es la serpiente más pesada y una de las más grandes del mundo, endémica de los ríos y humedales de Sudamérica</field></shadow></value><next><block type=\"game_show_long_text\"><field name=\"layout\">DialogLayout.Bottom</field><value name=\"str\"><shadow type=\"text\"><field name=\"TEXT\">Tamaño y peso: Es una especie de gran envergadura donde las hembras son mucho más grandes que los machos. Pueden superar los 6 a 8 metros de longitud y pesar más de 200 a 250 kilogramos.</field></shadow></value><next><block type=\"hudChangeScoreBy\"><value name=\"value\"><shadow type=\"math_number\"><field name=\"NUM\">10</field></shadow></value><next><block type=\"spritedestroy2\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" _expanded=\"2\" _input_init=\"true\"></mutation><field name=\"effect\">effects.blizzard</field><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"tzC?~H#$VDLky90DU@@W\">serpiente</field></block></value><value name=\"duration\"><shadow type=\"timePicker\"><field name=\"ms\">500</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type=\"spritesoverlap\" x=\"1480\" y=\"1121\"><value name=\"HANDLER_DRAG_PARAM_sprite\"><block type=\"argument_reporter_custom\" deletable=\"false\"><mutation typename=\"Sprite\"></mutation><field name=\"VALUE\">sprite</field></block></value><value name=\"kind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">pez</field></shadow></value><value name=\"HANDLER_DRAG_PARAM_otherSprite\"><block type=\"argument_reporter_custom\" deletable=\"false\"><mutation typename=\"Sprite\"></mutation><field name=\"VALUE\">otherSprite</field></block></value><value name=\"otherKind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">Player</field></shadow></value><statement name=\"HANDLER\"><block type=\"game_show_long_text\"><field name=\"layout\">DialogLayout.Bottom</field><value name=\"str\"><shadow type=\"text\"><field name=\"TEXT\">El candirú (Vandellia cirrhosa), también conocido como pez vampiro o cañero, es un pequeño pez gato de agua dulce de la familia Trichomycteridae, nativo de la cuenca del río Amazonas</field></shadow></value><next><block type=\"game_show_long_text\"><field name=\"layout\">DialogLayout.Bottom</field><value name=\"str\"><shadow type=\"text\"><field name=\"TEXT\">Tamaño y peso: Alcanzan entre 28 y 38 cm de longitud y un peso de hasta 3,5 kg (pudiendo llegar excepcionalmente a más en condiciones óptimas)</field></shadow></value><next><block type=\"hudChangeScoreBy\"><value name=\"value\"><shadow type=\"math_number\"><field name=\"NUM\">10</field></shadow></value><next><block type=\"spritedestroy2\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" _expanded=\"2\" _input_init=\"true\"></mutation><field name=\"effect\">effects.blizzard</field><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"k:QFz*BGRbt=(4)+yGK:\">pez vampiro</field></block></value><value name=\"duration\"><shadow type=\"timePicker\"><field name=\"ms\">500</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type=\"spritesoverlap\" x=\"605\" y=\"1365\"><value name=\"HANDLER_DRAG_PARAM_sprite\"><block type=\"argument_reporter_custom\" deletable=\"false\"><mutation typename=\"Sprite\"></mutation><field name=\"VALUE\">sprite</field></block></value><value name=\"kind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">río</field></shadow></value><value name=\"HANDLER_DRAG_PARAM_otherSprite\"><block type=\"argument_reporter_custom\" deletable=\"false\"><mutation typename=\"Sprite\"></mutation><field name=\"VALUE\">otherSprite</field></block></value><value name=\"otherKind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">Player</field></shadow></value><statement name=\"HANDLER\"><block type=\"game_show_long_text\"><field name=\"layout\">DialogLayout.Bottom</field><value name=\"str\"><shadow type=\"text\"><field name=\"TEXT\">El guacamayo de Spix (Cyanopsitta spixii), también conocido como guacamayo azul pequeño, es un ave psitaciforme endémica de Brasil y se hizo mundialmente famoso por inspirar la película animada Río</field></shadow></value><next><block type=\"game_show_long_text\"><field name=\"layout\">DialogLayout.Bottom</field><value name=\"str\"><shadow type=\"text\"><field name=\"TEXT\">Tamaño y peso: Mide entre 55 y 60 cm de longitud. Los machos pesan alrededor de 320 g y las hembras cerca de 290 g.</field></shadow></value><next><block type=\"hudChangeScoreBy\"><value name=\"value\"><shadow type=\"math_number\"><field name=\"NUM\">10</field></shadow></value><next><block type=\"spritedestroy2\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" _expanded=\"2\" _input_init=\"true\"></mutation><field name=\"effect\">effects.blizzard</field><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"1:`[R9OUK{/jUtsJFuLH\">guacamayo de spix</field></block></value><value name=\"duration\"><shadow type=\"timePicker\"><field name=\"ms\">500</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type=\"spritesoverlap\" x=\"611\" y=\"1673\"><value name=\"HANDLER_DRAG_PARAM_sprite\"><block type=\"argument_reporter_custom\" deletable=\"false\"><mutation typename=\"Sprite\"></mutation><field name=\"VALUE\">sprite</field></block></value><value name=\"kind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">mono</field></shadow></value><value name=\"HANDLER_DRAG_PARAM_otherSprite\"><block type=\"argument_reporter_custom\" deletable=\"false\"><mutation typename=\"Sprite\"></mutation><field name=\"VALUE\">otherSprite</field></block></value><value name=\"otherKind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">Player</field></shadow></value><statement name=\"HANDLER\"><block type=\"game_show_long_text\"><field name=\"layout\">DialogLayout.Bottom</field><value name=\"str\"><shadow type=\"text\"><field name=\"TEXT\">El Alouatta seniculus (conocido comúnmente como mono aullador rojo, aullador colorado o mono congo) es un primate del Nuevo Mundo de la familia Atelidae</field></shadow></value><next><block type=\"game_show_long_text\"><field name=\"layout\">DialogLayout.Bottom</field><value name=\"str\"><shadow type=\"text\"><field name=\"TEXT\">Tamaño y peso: Los machos miden entre 49 y 72 cm y pesan cerca de 7,5 kg; las hembras miden de 46 a 57 cm y pesan alrededor de 6,3 kg. Ambos sexos tienen una larga cola prensil de 49 a 75 cm</field></shadow></value><next><block type=\"hudChangeScoreBy\"><value name=\"value\"><shadow type=\"math_number\"><field name=\"NUM\">10</field></shadow></value><next><block type=\"spritedestroy2\"><mutation xmlns=\"http://www.w3.o