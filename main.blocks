www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><field name="effect">effects.blizzard</field><value name="sprite"><block type="variables_get" id="HA@fOc.VVPhV?1~KkQp@"><field name="VAR" id="orvXfqYXu6;=0C!,~B*w">Letrero</field></block></value><value name="duration"><shadow type="timePicker" id=")mx740+fsrLx-F**M`D?"><field name="ms">500</field></shadow></value></block></next></block></statement></block><block type="spritesoverlap" id="pPH2~Viqy8f;^E+Fy9i[" x="1407" y="485"><value name="HANDLER_DRAG_PARAM_sprite"><block type="argument_reporter_custom" id="]tOC.tebWJ))=$kmqr2r" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">sprite</field></block></value><value name="kind"><shadow type="spritekind" id="45a-,Qa6ZG$MPib}zVl$"><field name="MEMBER">coin3</field></shadow></value><value name="HANDLER_DRAG_PARAM_otherSprite"><block type="argument_reporter_custom" id="S*Wlzh2f^%t_qJviBQ%#" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">otherSprite</field></block></value><value name="otherKind"><shadow type="spritekind" id="q`Hms~8n$zI33[b3Jtpp"><field name="MEMBER">Player</field></shadow></value><statement name="HANDLER"><block type="game_show_long_text" id="2B?%[u6_!|I:MnWxIp?X"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="$]0fZ6}iQeJX?IVH](m8"><field name="TEXT">La piraña roja (Pygocentrus nattereri), también conocida como piraña de vientre rojo, es un pez carnívoro de agua dulce originario de Sudamérica (cuencas del Amazonas, Orinoco y Paraná-Paraguay)</field></shadow></value><next><block type="game_show_long_text" id=")OuNGjK#b)CJluN`p#,?"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="WT:`5w;}GZcu]aep@{Av"><field name="TEXT">Tamaño y peso: Alcanzan entre 28 y 38 cm de longitud y un peso de hasta 3,5 kg (pudiendo llegar excepcionalmente a más en condiciones óptimas)</field></shadow></value><next><block type="hudChangeScoreBy" id="J7X])3$BaCQpY?{k:O7+"><value name="value"><shadow type="math_number" id=":#OwnE!7+W7+;f9_scI:"><field name="NUM">10</field></shadow></value><next><block type="spritedestroy2" id="uu|}`=!F7UPb!T9gMsSk"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><field name="effect">effects.blizzard</field><value name="sprite"><block type="variables_get" id="6OZ*FT[ZtIAMsgSDgGNz"><field name="VAR" id="i06hu7LS7:y8NpXc65!U">Piraña roja</field></block></value><value name="duration"><shadow type="timePicker" id="z%pY9U.X??{N+oGmoel2"><field name="ms">500</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type="spritesoverlap" id="ZKaWG@vs^Qa3xQ_IhowY" x="639" y="552"><value name="HANDLER_DRAG_PARAM_sprite"><block type="argument_reporter_custom" id="p1gl~Q8HHwqrnG6S0mp0" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">sprite</field></block></value><value name="kind"><shadow type="spritekind" id="o1mrBR/Q,F~I15=B5*FV"><field name="MEMBER">coin2</field></shadow></value><value name="HANDLER_DRAG_PARAM_otherSprite"><block type="argument_reporter_custom" id="165o9;$yYt.rV(!OKex4" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">otherSprite</field></block></value><value name="otherKind"><shadow type="spritekind" id="Zj2r^~:9/2WGMMqq|Mm["><field name="MEMBER">Player</field></shadow></value><statement name="HANDLER"><block type="game_show_long_text" id="yO{LKbHF?[H{7uo9sN9@"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="tZ.yYUW[Ec)SjWM?@fH*"><field name="TEXT">El carpincho o capibara (Hydrochoerus hydrochaeris) es el roedor más grande y pesado del planeta, y una de las especies más representativas de la fauna de la cuenca del Amazonas y de los humedales de Sudamérica</field></shadow></value><next><block type="hudChangeScoreBy" id="a*Kx$X6@pdV*wRf@zxl/"><value name="value"><shadow type="math_number" id="M6(P@P)t-Mmbj+SW78Zt"><field name="NUM">10</field></shadow></value><next><block type="spritedestroy2" id="Nw._t{o.HUD+Fkdvo%#p"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><field name="effect">effects.blizzard</field><value name="sprite"><block type="variables_get" id="2Yc]*3)]I_rnL#UJu6ka"><field name="VAR" id="cLK}5PZZy_!%5b*4^;U/">Carpincho</field></block></value><value name="duration"><shadow type="timePicker" id=";oNLS7Zn)40(HheRyN+/"><field name="ms">500</field></shadow></value></block></next></block></next></block></statement></block><block type="spritesoverlap" id="zlyS?h+#7P@PMazeTY,?" x="630" y="771"><value name="HANDLER_DRAG_PARAM_sprite"><block type="argument_reporter_custom" id="ZuvBaVy@Qn(B23,HqAn6" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">sprite</field></block></value><value name="kind"><shadow type="spritekind" id="l4?z;2(0/::cej0VeLvU"><field name="MEMBER">tucan</field></shadow></value><value name="HANDLER_DRAG_PARAM_otherSprite"><block type="argument_reporter_custom" id=")g*zI)U2X%4UTng%r5%:" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">otherSprite</field></block></value><value name="otherKind"><shadow type="spritekind" id="JRsa{4Gc+0/5w:FU{Gts"><field name="MEMBER">Player</field></shadow></value><statement name="HANDLER"><block type="game_show_long_text" id="ngM[aX9B)9ncU]P}(iW."><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="[|pc0){{g5ET-5$~(s+4"><field name="TEXT">El tucán del Amazonas pertenece a la familia Ramphastidae (que incluye más de 35 a 40 especies en la región neotropical, como el tucán toco y el tucán de garganta blanca). Es uno de los símbolos más representativos de la selva tropical</field></shadow></value><next><block type="hudChangeScoreBy" id="ip%QWiNlbt{CJ#n+R09o"><value name="value"><shadow type="math_number" id="X-[%FgvSMaD$Sqq4e-EH"><field name="NUM">10</field></shadow></value><next><block type="spritedestroy2" id="NT+:)0#QI9iJL{zB6f^u"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><field name="effect">effects.blizzard</field><value name="sprite"><block type="variables_get" id="0B)[~q+sE/d6qRTBOL%F"><field name="VAR" id="3Uv$A2Xt1LZUc{F*YKZm">Tucán</field></block></value><value name="duration"><shadow type="timePicker" id="iUybNOl!.!/hgb|/9}5p"><field name="ms">500</field></shadow></value></block></next></block></next></block></statement></block><block type="spritesoverlap" id="TnYsD.:*ki.HwsIXu8qe" x="1465" y="809"><value name="HANDLER_DRAG_PARAM_sprite"><block type="argument_reporter_custom" id="b]xNORRGZyGm0%#,d8@/" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">sprite</field></block></value><value name="kind"><shadow type="spritekind" id=":;D+Oq168[$-YQGNrgnP"><field name="MEMBER">rosa</field></shadow></value><value name="HANDLER_DRAG_PARAM_otherSprite"><block type="argument_reporter_custom" id="$F{4m88$Sv)vEmDRjjew" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">otherSprite</field></block></value><value name="otherKind"><shadow type="spritekind" id="iy{tJ(m~t3CHC82OrhHD"><field name="MEMBER">Player</field></shadow></value><statement name="HANDLER"><block type="game_show_long_text" id="IKBd(=Dqu6B63zZtigfB"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="WV]IH:ZQf#m}ttEw[*:d"><field name="TEXT">El delfín rosado (conocido también como boto, bufeo o tonina) es el delfín de río más grande del mundo</field></shadow></value><next><block type="game_show_long_text" id="aRI;[mmKdB@bXCpZ(R_6"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="=RZ}##E8Kp[e-)Lw^)#m"><field name="TEXT">Tamaño y peso: Los adultos miden entre 1,5 y 2,5 metros de longitud y pueden pesar hasta cerca de 185–200 kg. Los machos suelen ser más grandes y rosados que las hembras</field></shadow></value><next><block type="hudChangeScoreBy" id="_kQ*4/7ch7Cge,~EHu6/"><value name="value"><shadow type="math_number" id=":5l29I/w]iJ2@fwP9oK-"><field name="NUM">10</field></shadow></value><next><block type="spritedestroy2" id=".xRkC8!Y4ase`^,-]NWo"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><field name="effect">effects.blizzard</field><value name="sprite"><block type="variables_get" id="7dR=PrW|r7$M5{~nf@?["><field name="VAR" id="036|Ed@4wEg?G!w?Z!Pz">Delfin rosado</field></block></value><value name="duration"><shadow type="timePicker" id="%8BOVXt3z!_T+Uo6}|si"><field name="ms">500</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type="spritesoverlap" id="(n6c_uMP!4{)@GeW@:mM" x="587" y="1063"><value name="HANDLER_DRAG_PARAM_sprite"><block type="argument_reporter_custom" id="E?6cbLwGmn#L|6@(joue" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">sprite</field></block></value><value name="kind"><shadow type="spritekind" id="VCXeP3Bs{hbsA?T|KpgE"><field name="MEMBER">serpiente</field></shadow></value><value name="HANDLER_DRAG_PARAM_otherSprite"><block type="argument_reporter_custom" id="3knV5DrtXpTqAgwxfB6e" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">otherSprite</field></block></value><value name="otherKind"><shadow type="spritekind" id="Ih8t~dfx-]vhuO%lyMf3"><field name="MEMBER">Player</field></shadow></value><statement name="HANDLER"><block type="game_show_long_text" id="aRsE9t)Re$d8qzfBq}!Q"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="0Sn}M*VPB#tnNU@Nh`Tt"><field name="TEXT">La anaconda verde (Eunectes murinus y la recientemente distinguida del norte Eunectes akayima) es la serpiente más pesada y una de las más grandes del mundo, endémica de los ríos y humedales de Sudamérica</field></shadow></value><next><block type="game_show_long_text" id="IkVS4W4,oQ=72R,e7^HJ"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="}TZ*vdkW%5pYU_f}thf/"><field name="TEXT">Tamaño y peso: Es una especie de gran envergadura donde las hembras son mucho más grandes que los machos. Pueden superar los 6 a 8 metros de longitud y pesar más de 200 a 250 kilogramos.</field></shadow></value><next><block type="hudChangeScoreBy" id="VCeovc*5iMT.ZF7JgVY."><value name="value"><shadow type="math_number" id="P45FgQTDUqi,8aU$cq%_"><field name="NUM">10</field></shadow></value><next><block type="spritedestroy2" id="0dFW/}]xqiVuZV#/!^~#"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><field name="effect">effects.blizzard</field><value name="sprite"><block type="variables_get" id="n_(!,Dh%3;[8{5d7V?nY"><field name="VAR" id="tzC?~H#$VDLky90DU@@W">serpiente</field></block></value><value name="duration"><shadow type="timePicker" id="UV)(4T[g$Hd9PUtNzW+F"><field name="ms">500</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type="spritesoverlap" id="vGeD4In+Mg/p=g:syryJ" x="1480" y="1121"><value name="HANDLER_DRAG_PARAM_sprite"><block type="argument_reporter_custom" id="IN2W@+km35!8dAabiSrC" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">sprite</field></block></value><value name="kind"><shadow type="spritekind" id="360nAYqKDTVxK3[llR+T"><field name="MEMBER">pez</field></shadow></value><value name="HANDLER_DRAG_PARAM_otherSprite"><block type="argument_reporter_custom" id="Ed$C*iH|;41$Rc+TOb[p" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">otherSprite</field></block></value><value name="otherKind"><shadow type="spritekind" id="IP%L|z)i.|=9_fNvwyOH"><field name="MEMBER">Player</field></shadow></value><statement name="HANDLER"><block type="game_show_long_text" id="?TA1.iP1UQPmRm4PhOj,"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="U/1AOGa7!QYfJm2`RxQx"><field name="TEXT">El candirú (Vandellia cirrhosa), también conocido como pez vampiro o cañero, es un pequeño pez gato de agua dulce de la familia Trichomycteridae, nativo de la cuenca del río Amazonas</field></shadow></value><next><block type="game_show_long_text" id="ed[yn,~XX4ma.-HiYmJh"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="0Qkk.g]=TjNy+%zbogF@"><field name="TEXT">Tamaño y peso: Alcanzan entre 28 y 38 cm de longitud y un peso de hasta 3,5 kg (pudiendo llegar excepcionalmente a más en condiciones óptimas)</field></shadow></value><next><block type="hudChangeScoreBy" id="t;V}YK5X3}`?yS_@ow?:"><value name="value"><shadow type="math_number" id="U.Ly5H3Zrs$2.JH!JN44"><field name="NUM">10</field></shadow></value><next><block type="spritedestroy2" id=",x#Hgh$u+$[_d/d@,gv#"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><field name="effect">effects.blizzard</field><value name="sprite"><block type="variables_get" id="OL%T)zLxyl3(q21$@y{u"><field name="VAR" id="k:QFz*BGRbt=(4)+yGK:">pez vampiro</field></block></value><value name="duration"><shadow type="timePicker" id="*@P+K}xFlH6gYgo6NFS+"><field name="ms">500</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type="spritesoverlap" id="gqGUn%~D!Ky*9y,`rU7u" x="605" y="1365"><value name="HANDLER_DRAG_PARAM_sprite"><block type="argument_reporter_custom" id="I}ySG$NE7bBOkgqmkfvA" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">sprite</field></block></value><value name="kind"><shadow type="spritekind" id="0NPyp%q`u;0Cga(HmKV:"><field name="MEMBER">río</field></shadow></value><value name="HANDLER_DRAG_PARAM_otherSprite"><block type="argument_reporter_custom" id="[d%QMECl~)^r#Fs0L_Ts" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">otherSprite</field></block></value><value name="otherKind"><shadow type="spritekind" id="r5Sp[|4q57Ih)cH;CUO1"><field name="MEMBER">Player</field></shadow></value><statement name="HANDLER"><block type="game_show_long_text" id="(/5:S=lf?A3nQT8=z+p_"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="#(I-xo/%hpu8D(E{2+rK"><field name="TEXT">El guacamayo de Spix (Cyanopsitta spixii), también conocido como guacamayo azul pequeño, es un ave psitaciforme endémica de Brasil y se hizo mundialmente famoso por inspirar la película animada Río</field></shadow></value><next><block type="game_show_long_text" id=";C_6g@z|UM%a@X2]08z/"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="GDctJ1kdz3_ZejLKu{#I"><field name="TEXT">Tamaño y peso: Mide entre 55 y 60 cm de longitud. Los machos pesan alrededor de 320 g y las hembras cerca de 290 g.</field></shadow></value><next><block type="hudChangeScoreBy" id="F+-R3v~~g/`z/)%CO0_:"><value name="value"><shadow type="math_number" id="Fyl/XNUgmWVUhyR.]l3e"><field name="NUM">10</field></shadow></value><next><block type="spritedestroy2" id="go+DJf{ZXQeJfh*MApw)"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><field name="effect">effects.blizzard</field><value name="sprite"><block type="variables_get" id="J1#dsbAsYgsiFz86T^8!"><field name="VAR" id="1:`[R9OUK{/jUtsJFuLH">guacamayo de spix</field></block></value><value name="duration"><shadow type="timePicker" id="|-.o#BrBBug-dx-w#ZJL"><field name="ms">500</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type="spritesoverlap" id="7jUlsXwYWH.G~T{f@C/c" x="611" y="1673"><value name="HANDLER_DRAG_PARAM_sprite"><block type="argument_reporter_custom" id=":==c$m9/[s*K+KjjOSJU" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">sprite</field></block></value><value name="kind"><shadow type="spritekind" id=":LX|+Qc#Jyc(c#dh?Fvf"><field name="MEMBER">mono</field></shadow></value><value name="HANDLER_DRAG_PARAM_otherSprite"><block type="argument_reporter_custom" id="L,vVV,?5EIYHnn3`cR57" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">otherSprite</field></block></value><value name="otherKind"><shadow type="spritekind" id="oV}[4FR]ZvoPi{g(vKId"><field name="MEMBER">Player</field></shadow></value><statement name="HANDLER"><block type="game_show_long_text" id=";12v~{V!,;3~0J)+ZdA5"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="@CY;`N;E|oBGV~CP~^Sz"><field name="TEXT">El Alouatta seniculus (conocido comúnmente como mono aullador rojo, aullador colorado o mono congo) es un primate del Nuevo Mundo de la familia Atelidae</field></shadow></value><next><block type="game_show_long_text" id="-v/CmC_yWx+$jy:Pbs%$"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="}mQtUR+9gxG?ZRja_#*D"><field name="TEXT">Tamaño y peso: Los machos miden entre 49 y 72 cm y pesan cerca de 7,5 kg; las hembras miden de 46 a 57 cm y pesan alrededor de 6,3 kg. Ambos sexos tienen una larga cola prensil de 49 a 75 cm</field></shadow></value><next><block type="hudChangeScoreBy" id="d?A?MVqq2`fMAvaxU[#$"><value name="value"><shadow type="math_number" id="q|7g2QCNInb+n^U^^+qQ"><field name="NUM">10</field></shadow></value><next><block type="spritedestroy2" id="t;lCv%(goz=T-*74[t%v"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><field name="effect">effects.blizzard</field><value name="sprite"><block type="variables_get" id="OW!VNbE$==M^Bh)$$H^1"><field name="VAR" id="k}C8sF;vi6/dHNs,K8go">mono</field></block></value><value name="duration"><shadow type="timePicker" id="w$FLX,qxUvx4J|QUA{}+"><field name="ms">500</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type="spritesoverlap" id="TA.h`|cQqFE$`[[3;LHm" x="-239" y="1810"><value name="HANDLER_DRAG_PARAM_sprite"><block type="argument_reporter_custom" id="qNuhG$ekqrkY~,eTWp[q" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">sprite</field></block></value><value name="kind"><shadow type="spritekind" id="T%L6jdVC~|_RP5`8c$D="><field name="MEMBER">rana</field></shadow></value><value name="HANDLER_DRAG_PARAM_otherSprite"><block type="argument_reporter_custom" id="]ejHD~|X-%Z,_{8W3XYY" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">otherSprite</field></block></value><value name="otherKind"><shadow type="spritekind" id="]mK9Q_PUVfR0O(7v,G5r"><field name="MEMBER">Player</field></shadow></value><statement name="HANDLER"><block type="game_show_long_text" id="Y[l,MbsqTL5=%5Hi^VTg"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="I3e#`*KMKh2``IGmkwy^"><field name="TEXT">La rana dorada venenosa (Phyllobates terribilis), también conocida como rana dardo dorada, es considerada uno de los animales más tóxicos del planeta</field></shadow></value><next><block type="game_show_long_text" id="-*_vjJ,OPv#E8W%ipi9Q"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="0`*~}}kiQJat`KukgJp?"><field name="TEXT">Tamaño: Mide alrededor de 5 centímetros (las hembras son ligeramente más grandes, hasta 5,5 cm).</field></shadow></value><next><block type="hudChangeScoreBy" id="]nR.aFoywBj2zr^LYxpg"><value name="value"><shadow type="math_number" id="]0B%j.MKDpjyQ[Xd9YSM"><field name="NUM">10</field></shadow></value><next><block type="spritedestroy2" id="qUZyNK~%c;J+b(F0cW]W"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><field name="effect">effects.blizzard</field><value name="sprite"><block type="variables_get" id="uVWo?.UTgkd9@es6$Vm:"><field name="VAR" id="AQ)2DRlB+_t+Lb1U%er:">rana</field></block></value><value name="duration"><shadow type="timePicker" id="#|@%3vj^^qA!$obERdE*"><field name="ms">500</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type="spritesoverlap" id="P]k_7A7G[5;^?4@atJy$" x="170" y="2095"><value name="HANDLER_DRAG_PARAM_sprite"><block type="argument_reporter_custom" id="aRNI-o}EiO~o=],oVy5F" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">sprite</field></block></value><value name="kind"><shadow type="spritekind" id="oDr{}-CdlVy#h#khjdZH"><field name="MEMBER">santi</field></shadow></value><value name="HANDLER_DRAG_PARAM_otherSprite"><block type="argument_reporter_custom" id="~vEg|iNQ{-Bt_Vx[%!!#" deletable="false"><mutation typename="Sprite"></mutation><field name="VALUE">otherSprite</field></block></value><value name="otherKind"><shadow type="spritekind" id="i`5A7*zRBESs,6JYsn@;"><field name="MEMBER">Player</field></shadow></value><statement name="HANDLER"><block type="game_show_long_text" id="|SZ+,.7j)}-eW!u:nH^M"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="i*ptsI;bBFnq4fo0P*F5"><field name="TEXT">perezoso (suborden Folivora) es un mamífero placentario neotropical famoso por su metabolismo ultralento y su vida casi permanentemente suspendida en los árboles.</field></shadow></value><next><block type="game_show_long_text" id="BKdpS.ILL1w}!*mNc{0R"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="eWo]LU/%i*1-MYz#Wm|*"><field name="TEXT">Perezoso de tres dedos: Mide aproximadamente entre 50 y 60 centímetros de largo</field></shadow></value><next><block type="hudChangeScoreBy" id="0v]$h4:sDP,B*kQ0f86y"><value name="value"><shadow type="math_number" id="_;vBfNl4+k7%Uu*$/[)E"><field name="NUM">10</field></shadow></value><next><block type="spritedestroy2" id="f]~3:}iH#QGMV.D*88s*"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><field name="effect">effects.blizzard</field><value name="sprite"><block type="variables_get" id="a:KCCw!TS`z2t%PlXj_r"><field name="VAR" id="2/SzcHFhrQ?U~[Ra5jzx">perezoso</field></block></value><value name="duration"><shadow type="timePicker" id="Kd_uCm/DsVns^DMO?y7."><field name="ms">500</field></shadow></value></block></next></block></next></block></next></block></statement></block></xml>